MODULE    = winebus.sys
UNIXLIB   = winebus.so
IMPORTS   = ntoskrnl hidparse
# Unix side links the standalone Rust Sony-rumble core (libwine_winebus.so,
# rust/src_sys/winebus): DualShock 4 / DualSense force feedback for the hidraw
# passthrough backend (see bus_udev.c sony_rumble_init).
UNIX_LIBS    = $(IOKIT_LIBS) $(UDEV_LIBS) $(PTHREAD_LIBS) $(INOTIFY_LIBS) $(WINE_RUST_LDFLAGS) -Wl,-lwine_winebus
UNIX_CFLAGS  = $(INOTIFY_CFLAGS) $(UDEV_CFLAGS) $(SDL2_CFLAGS)

EXTRADLLFLAGS = -Wl,--subsystem,native

SOURCES = \
	bus_iohid.c \
	bus_sdl.c \
	bus_udev.c \
	hid.c \
	main.c \
	unixlib.c \
	winebus.rc
