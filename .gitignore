
# Claude Code agent memory (local, not part of the project)
memory/

# packaging output (relocatable tarballs + staging tree)
dist/

# installer build output (core + gui are standalone crates with their own target dirs)
installer/*/target/

rust/target/
# stray per-crate target dirs (e.g. from `cargo test` in an excluded crate dir);
# the real builds use the shared rust/target/
rust/**/target/
rust/Cargo.lock
rust/src_lib/generated/

**/*.dll
**/*.exe

**/*.ax
**/*.acm
**/*.tlb
**/*.o
**/*.so
**/*.res

# sodactl: host tool with its OWN workspace and lockfile, so it has its own
# target dir rather than sharing rust/target/. The fixture is a generated
# synthetic repo -- mkfixture.sh rebuilds it in <1s, so it is never committed.
tools/sodactl/target/
tools/sodactl/tests/fixtures/
